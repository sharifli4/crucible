            "content": "/* ─── Reset & variables ───────────────────────────────────────────────────── */\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n:root {\n  --bg:      #080810;\n  --surface: #0f0f1a;\n  --card:    #13131f;\n  --border:  #1c1c2e;\n  --text:    #ddddf0;\n  --muted:   #5a5a7a;\n\n  /* Agent colours */\n  --alpha:   #4a9eff;\n  --beta:    #ff4f4f;\n  --gamma:   #3effa0;\n  --delta:   #ffaa33;\n  --epsilon: #bf6aff;\n  --arbiter: #ffd700;\n}\n\nhtml, body { height: 100%; overflow: hidden; }\n\nbody {\n  background: var(--bg);\n  color: var(--text);\n  font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', monospace;\n}\n\n/* ─── App shell ───────────────────────────────────────────────────────────── */\n#app { display: flex; flex-direction: column; height: 100vh; }\n\n/* ─── Header ──────────────────────────────────────────────────────────────── */\nheader {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: 10px 20px;\n  background: var(--surface);\n  border-bottom: 1px solid var(--border);\n  flex-shrink: 0;\n}\n\n#title {\n  font-size: 16px;\n  font-weight: 800;\n  letter-spacing: 5px;\n  color: var(--arbiter);\n  text-shadow: 0 0 18px rgba(255,215,0,.45);\n  white-space: nowrap;\n}\n\n#phase-label {\n  font-size: 12px;\n  background: var(--border);\n  padding: 3px 12px;\n  border-radius: 99px;\n  white-space: nowrap;\n}\n\n#task-label {\n  font-size: 11px;\n  color: var(--muted);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  flex: 1;\n}\n\n/* ─── Main layout ─────────────────────────────────────────────────────────── */\nmain { display: flex; flex: 1; overflow: hidden; }\n\n/* ─── Arena ───────────────────────────────────────────────────────────────── */\n#arena {\n  flex: 1;\n  position: relative;\n  background:\n    radial-gradient(ellipse 60% 55% at 50% 50%, rgba(74,158,255,.04) 0%, transparent 70%),\n    var(--bg);\n  overflow: hidden;\n}\n\n/* subtle hex grid overlay */\n#arena::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background-image:\n    linear-gradient(rgba(255,255,255,.015) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(255,255,255,.015) 1px, transparent 1px);\n  background-size: 40px 40px;\n  pointer-events: none;\n}\n\n#arrows {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n}\n\n#round-badge {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  font-size: 10px;\n  letter-spacing: 3px;\n  color: var(--muted);\n  text-align: center;\n  pointer-events: none;\n  user-select: none;\n}\n\n/* ─── Convergence overlay ─────────────────────────────────────────────────── */\n#convergence-overlay {\n  display: none;\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  background: rgba(8,8,16,.92);\n  border: 1px solid var(--border);\n  border-radius: 14px;\n  padding: 22px 40px;\n  text-align: center;\n  z-index: 20;\n  backdrop-filter: blur(6px);\n}\n#convergence-overlay.visible { display: block; }\n#convergence-overlay .verdict {\n  font-size: 26px;\n  font-weight: 800;\n  letter-spacing: 5px;\n}\n#convergence-overlay .converged { color: var(--gamma); }\n#convergence-overlay .diverged  { color: var(--beta); }\n#convergence-overlay .reason {\n  font-size: 11px;\n  color: var(--muted);\n  margin-top: 8px;\n  max-width: 260px;\n}\n\n/* ─── Agent card ──────────────────────────────────────────────────────────── */\n.agent-card {\n  position: absolute;\n  width: 130px;\n  transform: translate(-50%, -50%);\n  background: var(--card);\n  border: 2px solid var(--c, #333);\n  border-radius: 14px;\n  padding: 12px 10px 10px;\n  text-align: center;\n  transition: box-shadow .3s, border-color .3s;\n  user-select: none;\n}\n\n.agent-card.glow {\n  box-shadow: 0 0 28px var(--c);\n}\n\n.agent-card.shake {\n  animation: shake .4s ease;\n}\n\n.agent-avatar { font-size: 28px; line-height: 1; margin-bottom: 6px; }\n\n.agent-name {\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 3px;\n  color: var(--c, var(--text));\n}\n\n.agent-status {\n  font-size: 9px;\n  color: var(--muted);\n  letter-spacing: 1px;\n  margin: 5px 0 8px;\n  min-height: 12px;\n}\n\n.hp-track {\n  height: 3px;\n  background: var(--border);\n  border-radius: 2px;\n  overflow: hidden;\n}\n.hp-fill {\n  height: 100%;\n  background: var(--c, #4a9eff);\n  border-radius: 2px;\n  transition: width .6s ease;\n}\n\n/* Arbiter card */\n.arbiter-card {\n  position: absolute;\n  transform: translate(-50%, -50%);\n  background: var(--card);\n  border: 2px solid var(--arbiter);\n  border-radius: 14px;\n  padding: 10px 18px;\n  text-align: center;\n  display: none;\n  --c: var(--arbiter);\n}\n.arbiter-card.visible { display: block; }\n.arbiter-card .agent-name { color: var(--arbiter); }\n\n/* ─── Side panel ──────────────────────────────────────────────────────────── */\n#panel {\n  width: 360px;\n  border-left: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  flex-shrink: 0;\n}\n\n/* Speech box */\n#speech-box {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  border-bottom: 1px solid var(--border);\n}\n\n#speech-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 10px 14px 8px;\n  border-bottom: 1px solid var(--border);\n  flex-shrink: 0;\n}\n\n#speech-from {\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 2px;\n}\n\n#speech-tag {\n  font-size: 9px;\n  padding: 2px 8px;\n  border-radius: 99px;\n  background: var(--border);\n  color: var(--muted);\n  letter-spacing: 1px;\n}\n\n#speech-content {\n  flex: 1;\n  overflow-y: auto;\n  padding: 12px 14px;\n  font-size: 11.5px;\n  line-height: 1.65;\n  color: #b8b8d8;\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n\n#speech-content code {\n  background: var(--border);\n  padding: 1px 5px;\n  border-radius: 3px;\n  font-size: 10px;\n}\n\n/* Log */\n#log {\n  height: 185px;\n  display: flex;\n  flex-direction: column;\n  flex-shrink: 0;\n}\n\n#log-title {\n  font-size: 9px;\n  letter-spacing: 3px;\n  color: var(--muted);\n  padding: 7px 14px;\n  border-bottom: 1px solid var(--border);\n}\n\n#log-entries {\n  flex: 1;\n  overflow-y: auto;\n  padding: 6px 0;\n}\n\n.log-entry {\n  display: flex;\n  align-items: baseline;\n  gap: 8px;\n  padding: 3px 14px;\n  font-size: 10px;\n  color: var(--muted);\n  animation: fadein .25s ease;\n}\n.log-entry:hover { background: rgba(255,255,255,.02); }\n\n.log-tag {\n  flex-shrink: 0;\n  font-size: 9px;\n  padding: 1px 6px;\n  border-radius: 4px;\n  font-weight: 700;\n  letter-spacing: .5px;\n}\n\n.log-text { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n/* ─── Animations ──────────────────────────────────────────────────────────── */\n@keyframes fadein {\n  from { opacity: 0; transform: translateY(3px); }\n  to   { opacity: 1; transform: translateY(0); }\n}\n\n@keyframes shake {\n  0%,100% { transform: translate(-50%,-50%) translateX(0); }\n  20%     { transform: translate(-50%,-50%) translateX(-5px); }\n  40%     { transform: translate(-50%,-50%) translateX(5px); }\n  60%     { transform: translate(-50%,-50%) translateX(-4px); }\n  80%     { transform: translate(-50%,-50%) translateX(4px); }\n}\n\n@keyframes pop {\n  0%   { transform: translate(-50%,-50%) scale(.93); }\n  60%  { transform: translate(-50%,-50%) scale(1.06); }\n  100% { transform: translate(-50%,-50%) scale(1); }\n}\n\n.agent-card.pop { animation: pop .35s ease; }\n\n/* ─── Scrollbars ──────────────────────────────────────────────────────────── */\n::-webkit-scrollbar { width: 3px; }\n::-webkit-scrollbar-track { background: transparent; }\n::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }\n",
